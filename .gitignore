# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...кроме образца: секретов в нём нет, а без него в свежем клоне негде
# посмотреть, какие переменные вообще бывают. README на него ссылается.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# сгенерированное превью (собирается командой scripts/make-preview.mjs)
/preview.html
/public/preview.html

# graphify (генерируется скилом graphify)
graphify-out/

# сборка функции приёма заявок (собирается командой npm run build:lead)
/server/lead/dist/
/server/lead/lead-function.zip
