# Скопируйте этот файл в .env.local и заполните значения.
# .env.local в репозиторий не попадает — настоящие ключи храните только там.

# --- Адрес сайта -------------------------------------------------------------
# Используется в canonical, sitemap.xml и Open Graph. Без слэша на конце.
# Для тестового размещения укажите адрес тестовой площадки.
NEXT_PUBLIC_SITE_URL=https://primeswim.ru

# --- Индексация поисковыми системами -----------------------------------------
# false (или не задано) — сайт закрыт от индексации. Так должно быть на тесте.
# true — сайт открыт для поиска. Ставьте true ТОЛЬКО на боевом домене.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Приём заявок с формы ----------------------------------------------------
# Адрес приёмника, который принимает заявку и отправляет её ботом в MAX.
# Код лежит в server/lead, инструкция по установке — server/lead/README.md.
#
# Пока адрес не задан, форма показывает честную ошибку и прямые контакты:
# ложное «спасибо» посетителю не показывается ни при каких условиях.
#
# Для локальной разработки сюда ставится адрес локального приёмника,
# например http://localhost:8788/lead
NEXT_PUBLIC_LEAD_ENDPOINT=

# Токен бота MAX и чат, куда падают заявки, здесь НЕ ХРАНЯТСЯ и не должны.
# Они задаются переменными окружения самого приёмника на хостинге: MAX_BOT_TOKEN,
# MAX_CHAT_ID (или MAX_USER_ID), ALLOWED_ORIGINS. Любая переменная с
# префиксом NEXT_PUBLIC_ попадает в код страницы и видна всем.

# --- Аналитика ---------------------------------------------------------------
# Номер счётчика Яндекс Метрики. Пока пусто — счётчик не подключается.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
